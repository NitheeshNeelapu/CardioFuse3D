# Gemini API Key (Required for LLM features: Agent explanation, patient summary, translation, ECG photo extraction)
# In development, you can set this in .env.local or your environment
GEMINI_API_KEY=

# Gemini Model name (Defaults to gemini-1.5-flash)
LLM_MODEL=gemini-1.5-flash

# Backend API Base URL (defaults to production Render backend)
VITE_API_BASE_URL=https://cardiofuse3d.onrender.com
